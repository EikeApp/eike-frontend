# Exceptions to the iOS rules above
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3

# macOS (kept in case the macOS platform is added later)
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral/
**/xcuserdata/

# Windows (kept in case the Windows platform is added later)
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake

# Linux (kept in case the Linux platform is added later)
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake

# Eike content (fetched via scripts/fetch_content.sh, see Makefile)
packages/eike_app/assets/content/

# Maestro report output (written by ci/start-and-wait-for-emulator.sh)
/maestro/
